[package]
name = "file-tree-beta-contract"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false
[dependencies]
beta-fixture = { path = "fixture" }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"
tokio = { version = "=1.48.0", features = ["rt-multi-thread", "macros", "sync", "time"] }
uuid = { version = "=1.18.1", features = ["v4"] }
tempfile = "=3.23.0"
log = "=0.4.28"
